{
	"name": "up-finance-handbook",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// matches the other exciseup.in workers (pac-recovery-portal, sro) — the *.workers.dev
	// URL is retired in favour of the custom domain from the start.
	"workers_dev": false,
	"routes": [
		{ "pattern": "financialhandbook.exciseup.in", "custom_domain": true }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "up-finance-handbook-db",
			"database_id": "4699709e-001c-4af1-9649-b5e2cb79df60",
			"migrations_dir": "migrations"
		}
	]
}
