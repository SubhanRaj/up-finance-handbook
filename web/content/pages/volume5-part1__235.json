t number</p></font></td>\n<td height=\"50\" rowspan=\"2\" valign=\"TOP\" width=\"16%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">Temporary advance</p></font></td>\n<td colspan=\"3\" height=\"50\" valign=\"TOP\" width=\"31%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">*Amount of</p></font></td>\n<td height=\"50\" rowspan=\"2\" valign=\"TOP\" width=\"13%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">Remark*</p></font></td>\n</tr>\n<tr><td height=\"50\" valign=\"TOP\" width=\"11%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">Nonrefundable advance</p></font></td>\n<td height=\"50\" valign=\"TOP\" width=\"11%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">Advance for payment of premium</p></font></td>\n<td height=\"50\" valign=\"TOP\" width=\"9%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">Final payment</p></font></td>\n</tr>\n<tr><td valign=\"TOP\" width=\"10%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">1</p></font></td>\n<td valign=\"TOP\" width=\"16%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">2</p></font></td>\n<td valign=\"TOP\" width=\"13%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">3</p></font></td>\n<td valign=\"TOP\" width=\"16%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">4</p></font></td>\n<td valign=\"TOP\" width=\"11%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">5</p></font></td>\n<td valign=\"TOP\" width=\"11%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">6</p></font></td>\n<td valign=\"TOP\" width=\"9%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">7</p></font></td>\n<td valign=\"TOP\" width=\"13%\">\n<font color=\"#800000\" size=\"4\"><p align=\"CENTER\">8</p></font></td>\n</tr>\n<tr><td height=\"166\" valign=\"TOP\" width=\"10%\"><p></p></td>\n<td height=\"166\" valign=\"TOP\" width=\"16%\"><p></p></td>\n<td height=\"166\" valign=\"TOP\" width=\"13%\"><p></p></td>\n<td height=\"