# https://developers.cloudflare.com/workers/static-assets/headers
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Kruti Dev font — versioned filename would be cleaner, but this file never
# changes; browser + our own service worker (sw.js) both cache it after the
# very first request either way.
/fonts/*
  Cache-Control: public,max-age=31536000,immutable
